# ---- Application ----------------------------------------------------------
AIC_ENV=local
AIC_LOG_LEVEL=INFO
AIC_LOG_FORMAT=json          # json | console

# ---- LLM ------------------------------------------------------------------
# Provider: anthropic | fake
# "fake" runs the whole pipeline with a deterministic scripted model, so the
# project is fully runnable and testable without credentials.
AIC_LLM_PROVIDER=fake
AIC_LLM_MODEL=claude-opus-5
AIC_LLM_EFFORT=high          # low | medium | high | xhigh | max
AIC_LLM_MAX_TOKENS=16000
AIC_LLM_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=

# ---- Persistence ----------------------------------------------------------
AIC_DATABASE_URL=postgresql://aic:aic@localhost:5432/aic
AIC_REDIS_URL=redis://localhost:6379/0

# ---- Guardrails -----------------------------------------------------------
# Nothing above this risk level may ever run without a human approval.
AIC_AUTO_APPROVE_MAX_RISK=read_only   # read_only | low | medium | high
AIC_MAX_AGENT_RETRIES=2
AIC_INVESTIGATION_TIMEOUT_SECONDS=300
